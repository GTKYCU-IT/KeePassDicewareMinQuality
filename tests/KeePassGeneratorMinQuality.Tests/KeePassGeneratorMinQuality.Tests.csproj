<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\KeePass.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Released upstream plugin the tests run against; build.ps1 downloads the pinned version here. -->
    <DicewareDll Condition="'$(DicewareDll)' == ''">$(MSBuildThisFileDirectory)..\..\.deps\KeePassDiceware.dll</DicewareDll>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\KeePassGeneratorMinQuality.csproj" />
    <Reference Include="KeePassDiceware">
      <HintPath>$(DicewareDll)</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="All" />
  </ItemGroup>
  <Target Name="CheckDicewareDll" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DicewareDll)')"
           Text="'$(DicewareDll)' not found. Run ./build.ps1 once (it downloads the pinned upstream plugin) or pass -p:DicewareDll=&lt;path&gt;." />
  </Target>
</Project>

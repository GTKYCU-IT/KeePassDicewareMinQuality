<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="KeePass.props" />
  <PropertyGroup>
    <!-- Same target as the upstream Diceware plugin this wraps. -->
    <TargetFramework>net452</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- KeePass only loads DLL plugins whose Product is exactly "KeePass Plugin". -->
    <Product>KeePass Plugin</Product>
    <AssemblyTitle>KeePass Generator Minimum Quality</AssemblyTitle>
    <Description>Enforces a minimum KeePass quality estimate on passwords from selected plugin password generators.</Description>
    <Company>Greater Kentucky Credit Union, Inc.</Company>
    <Copyright>Copyright © 2026 Greater Kentucky Credit Union, Inc.</Copyright>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Keep in sync with .meta/version.info (build.ps1 checks). -->
    <VersionPrefix>1.0.1</VersionPrefix>

    <!-- The test project lives under tests/ and must not be globbed into the plugin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Update="KeePass">
      <!-- KeePass.exe is the host; never copy it next to the plugin DLL. -->
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <InternalsVisibleTo Include="KeePassGeneratorMinQuality.Tests" />
  </ItemGroup>
</Project>
